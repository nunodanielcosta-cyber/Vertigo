{
  "name": "vertigo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vertigo — análise automática de nistagmo por visão computacional e apoio ao diagnóstico de vertigem posicional",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
